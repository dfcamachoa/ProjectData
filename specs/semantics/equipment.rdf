    <!-- http://rds.posccaesar.org/ontology/plm/rdl/PCA_100001002 -->

    <owl:Class rdf:about="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100001002">
        <rdfs:subClassOf rdf:resource="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100001001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rds.posccaesar.org/ontology/lis14/rdl/hasFunction"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://rds.posccaesar.org/ontology/lis14/rdl/realizedIn"/>
                        <owl:allValuesFrom rdf:resource="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100000010"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A &apos;gas pressure increase device&apos; and an &apos;artefact&apos; that is driven by a prime mover by which energy is either constantly or periodically added to an amount of gas in order to increase its pressure.</rdfs:comment>
        <rdfs:label>Compressor</rdfs:label>
        <skos:closeMatch rdf:resource="http://data.posccaesar.org/rdl/RDS14286497"/>
